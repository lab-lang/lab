                      }
                    }
                  },
                  "positions": 1
                }
              ],
              "steps": [
                {
                  "id": "move-sample",
                  "kind": "transfer",
                  "source": {
                    "vessel": "sample",
                    "position": 0
                  },
                  "destination": {
                    "vessel": "prepared",
                    "position": 0
                  },
                  "volume": {
                    "$lab": {
                      "kind": "scalar",
                      "id": "sample_volume"
                    }
                  },
                  "fluid_path": "isolated_destinations",
                  "fluid_path_group": "sample-path"
                },
                {
                  "id": "mix-sample",
                  "kind": "mix",
                  "targets": [
                    {
                      "vessel": "prepared",
                      "position": 0
                    }
                  ],
                  "volume": {
                    "$lab": {
                      "kind": "scalar",
                      "id": "mix_volume"
                    }
                  },
                  "cycles": {
                    "$lab": {
                      "kind": "integer",
                      "id": "mix_cycles"
                    }
                  },
                  "fluid_path": "isolated_destinations",
                  "fluid_path_group": "sample-path"
                }
              ],
              "outputs": [
                {
                  "id": {
                    "$lab": {
                      "kind": "output",
                      "id": "prepared"
                    }
                  }
                }
              ]
            },
            "policy": {
              "minimum_qualification": "https://sbol.io/ns/facility#Plannable",
              "accepted_control_modes": [
                "https://sbol.io/ns/facility#ReviewedFileControl"
              ]
