              "property_kind": "https://example.org/parameter#sample_volume",
              "value": {
                "kind": "literal",
                "value": {
                  "kind": "scalar",
                  "value": {
                    "value": {
                      "type": "real",
                      "value": "30"
                    },
                    "unit": "http://qudt.org/vocab/unit/MicroL"
                  }
                }
              }
            },
            {
              "id": "mix_volume",
              "property_kind": "https://example.org/parameter#mix_volume",
              "value": {
                "kind": "literal",
                "value": {
                  "kind": "scalar",
                  "value": {
                    "value": {
                      "type": "real",
                      "value": "10"
                    },
                    "unit": "http://qudt.org/vocab/unit/MicroL"
                  }
                }
              }
            },
            {
              "id": "mix_cycles",
              "property_kind": "https://example.org/parameter#mix_cycles",
              "value": {
                "kind": "literal",
                "value": {
                  "kind": "scalar",
                  "value": {
                    "value": {
                      "type": "integer",
                      "value": "3"
                    }
                  }
                }
              }
            }
          ],
          "materials": [],
          "execution": {
            "kind": "template",
            "contract": "https://www.lab-compiler.org/ns/procedure-contract#PipettingProgramV1",
            "body": {
              "vessels": [
                {
                  "id": "sample",
                  "role": {
                    "kind": "procedure_input",
                    "input": {
                      "$lab": {
                        "kind": "input",
                        "index": 0
                      }
                    }
                  },
                  "positions": 1,
                  "initial_volume_each": {
                    "$lab": {
                      "kind": "scalar",
                      "id": "sample_volume"
                    }
                  }
                },
                {
                  "id": "prepared",
                  "role": {
                    "kind": "product",
                    "output": {
