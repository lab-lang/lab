use std.lab.plasmid
use golden_gate.designs.strains
use golden_gate.workflows.assemble
use golden_gate.workflows.build_strains

/**
 * Assemble GFP and RFP plasmids, then transform three GFP and six RFP
 * replicates using separate DH5alpha cell supplies.
 */
workflow main() -> (
  gfp: Material<Strain>,
  rfp: Material<Strain>,
):
  GVD0011 <- assemble_GVD0011
  GVD0013 <- assemble_GVD0013
  gfp, gfp_plate <- build_GVD_strain GFP_strain GVD0011
  rfp, rfp_plate <- build_GVD_strain RFP_strain GVD0013
  <- dispose gfp_plate
  <- dispose rfp_plate
  return gfp, rfp
