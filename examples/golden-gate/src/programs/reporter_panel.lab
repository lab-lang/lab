use std.lab.plasmid
use golden_gate.workflows.assemble
use golden_gate.workflows.build_strains

/**
 * Assemble all three GVD plasmids, then perform their three-replicate DH5alpha
 * cotransformation as one lineage-preserving workflow.
 */
workflow main() -> Material<Strain>:
  GVD0011 <- assemble_GVD0011
  GVD0013 <- assemble_GVD0013
  GVD0015 <- assemble_GVD0015

  strain, plate <- build_GVD_strain GVD0011 GVD0013 GVD0015
  <- dispose plate
  return strain
