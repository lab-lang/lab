/*!
 * A single cotransformation in which DH5alpha receives all three GVD plasmids
 * in each of three replicate wells.
 */

use std.bio.designs
use std.bio.golden_gate

use golden_gate.designs.inventory
use golden_gate.designs.plasmids

/** DH5alpha cotransformed with GVD0011, GVD0013, and GVD0015. */
build strain GVD_strain:
  sbol_identity = "https://SBOL2Build.org/GVD_strain"
  chassis = DH5alpha
  plasmids = [GVD0011, GVD0013, GVD0015]
  selection = chloramphenicol
  transformation_replicates = 3
  plating_replicates = 1
  serial_dilutions = 2

  cell_aliquot_volume = 150 uL
  cell_volume = 20 uL
  dna_volume = 5 uL
  recovery_aliquot_volume = 1200 uL
  recovery_volume = 60 uL
  heat_shock_duration = 1 min
  medium_volume = 18 uL
  culture_volume = 2 uL
  colony_volume = 4 uL
