/*! Stage 1: assemble the three plasmids consumed by the transformation. */

use std.bio.build
use golden_gate.designs.plasmids

workflow assemble_GVD0011() -> Material<Plasmid>:
  product <- realize GVD0011
  return product

workflow assemble_GVD0013() -> Material<Plasmid>:
  product <- realize GVD0013
  return product

workflow assemble_GVD0015() -> Material<Plasmid>:
  product <- realize GVD0015
  return product
