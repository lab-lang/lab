/*!
 * Stages 2 and 3: assembled plasmids are introduced into competent cells by
 * heat shock, the recovered culture is diluted, and each dilution is spotted
 * onto selective agar.
 */

use std.bio.designs
use std.lab.plasmid
use golden_gate_extended.designs.inventory
use golden_gate_extended.designs.plasmids
use golden_gate_extended.designs.strains

/**
 * Build the GFP reporter in DH5alpha.
 *
 * Consumes the plasmid material it transforms, so the compiler knows this
 * strain cannot be built before that plasmid exists.
 */
workflow build_composite_strain_1(
  composite_plasmid_1: Material<Plasmid>,
) -> (
  strain: Material<Strain>,
  plate: Material<Medium is inoculated>,
):
  dependencies = [composite_plasmid_1]
  cells <- provision DH5alpha
  strain, culture <- transform composite_strain_1 from dependencies into cells
  culture <- recover culture for 1 h
  culture <- dilute culture
  agar <- provision LB_chloramphenicol_agar
  plate <- plate culture on agar
  return strain, plate

/** Build the RFP reporter in the same cloning strain. */
workflow build_composite_strain_2(
  composite_plasmid_2: Material<Plasmid>,
) -> (
  strain: Material<Strain>,
  plate: Material<Medium is inoculated>,
):
  dependencies = [composite_plasmid_2]
  cells <- provision DH5alpha
  strain, culture <- transform composite_strain_2 from dependencies into cells
  culture <- recover culture for 1 h
  culture <- dilute culture
  agar <- provision LB_chloramphenicol_agar
  plate <- plate culture on agar
  return strain, plate

/** Build the GFP reporter in BL21, where it is expressed rather than stored. */
workflow build_expression_strain(
  composite_plasmid_1: Material<Plasmid>,
) -> (
  strain: Material<Strain>,
  plate: Material<Medium is inoculated>,
):
  dependencies = [composite_plasmid_1]
  cells <- provision BL21
  strain, culture <- transform expression_strain from dependencies into cells
  culture <- recover culture for 1 h
  culture <- dilute culture
  agar <- provision LB_chloramphenicol_agar
  plate <- plate culture on agar
  return strain, plate

/**
 * Build the reference strain from a plasmid that was ordered rather than made.
 *
 * `provision` fetches a declared thing off the shelf, whatever it is. It does
 * not ask how the thing came to exist: one this laboratory bought and one it
 * assembled last month are both simply available, and which is which is a
 * question for the manifest rather than for this workflow.
 */
workflow build_reference_strain() -> (
  strain: Material<Strain>,
  plate: Material<Medium is inoculated>,
):
  // The binding takes the artifact's own name, which is how a build order
  // links a strain to the DNA that went into it.
  reference_gfp <- provision reference_gfp
  dependencies = [reference_gfp]
  cells <- provision BL21
  strain, culture <- transform reference_strain from dependencies into cells
  culture <- recover culture for 1 h
  culture <- dilute culture
  agar <- provision LB_chloramphenicol_agar
  plate <- plate culture on agar
  return strain, plate
