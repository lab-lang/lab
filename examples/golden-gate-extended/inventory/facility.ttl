@prefix cap: <https://sbol.io/ns/capability#> .
@prefix designs: <https://example.org/golden-gate/designs/> .
@prefix ex: <https://example.org/golden-gate/> .
@prefix fac: <https://sbol.io/ns/facility#> .
@prefix igem: <https://synbiohub.org/public/igem/> .
@prefix inv: <https://sbol.io/ns/inventory#> .
@prefix lots: <https://example.org/golden-gate/lots/> .
@prefix materials: <https://example.org/golden-gate/materials/> .
@prefix sbol: <http://sbols.org/v3#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:facility
    a sbol:TopLevel, fac:Facility ;
    sbol:displayId "facility" ;
    sbol:hasNamespace <https://example.org/golden-gate> ;
    sbol:name "Golden Gate example facility" .

ex:lab
    a sbol:TopLevel, fac:Zone ;
    sbol:displayId "lab" ;
    sbol:hasNamespace <https://example.org/golden-gate> ;
    sbol:name "Teaching laboratory" ;
    fac:facility ex:facility ;
    fac:zoneKind fac:Room ;
    fac:isActive true .

ex:automation_bench
    a sbol:TopLevel, fac:Zone ;
    sbol:displayId "automation_bench" ;
    sbol:hasNamespace <https://example.org/golden-gate> ;
    sbol:name "Automation bench" ;
    fac:facility ex:facility ;
    fac:parentZone ex:lab ;
    fac:zoneKind fac:WorkArea ;
    fac:isActive true .

ex:stock_storage
    a sbol:TopLevel, fac:Zone ;
    sbol:displayId "stock_storage" ;
    sbol:hasNamespace <https://example.org/golden-gate> ;
    sbol:name "Golden Gate stock storage" ;
    fac:facility ex:facility ;
    fac:parentZone ex:lab ;
    fac:zoneKind fac:StorageZone ;
    fac:isActive true .

ex:opentrons_ot2
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "opentrons_ot2" ;
    sbol:hasNamespace <https://example.org/golden-gate> ;
    sbol:name "Opentrons OT-2 with Thermocycler Module" ;
    fac:facility ex:facility ;
    fac:assetKind fac:Instrument ;
    fac:locatedIn ex:automation_bench ;
    fac:manufacturer "Opentrons" ;
    fac:model "OT-2 with Thermocycler Module GEN1" ;
    fac:isActive true ;
    fac:capability ex:opentrons_ot2_metered_liquid_transfer,
        ex:opentrons_ot2_in_well_mixing,
        ex:opentrons_ot2_liquid_level_aware_aspiration,
        ex:opentrons_ot2_programmed_block_temperature_control,
        ex:opentrons_ot2_heated_lid_temperature_control .

ex:opentrons_ot2_metered_liquid_transfer
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "metered_liquid_transfer" ;
    fac:capabilityKind cap:MeteredLiquidTransfer ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ReviewedFileControl ;
    fac:isActive true ;
    fac:parameter ex:opentrons_ot2_minimum_transfer_volume,
        ex:opentrons_ot2_maximum_transfer_volume .

ex:opentrons_ot2_minimum_transfer_volume
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "minimum_transfer_volume" ;
    fac:propertyKind cap:MinimumTransferVolume ;
    fac:realValue "1"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/MicroL> .

ex:opentrons_ot2_maximum_transfer_volume
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "maximum_transfer_volume" ;
    fac:propertyKind cap:MaximumTransferVolume ;
    fac:realValue "300"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/MicroL> .

ex:opentrons_ot2_in_well_mixing
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "in_well_mixing" ;
    fac:capabilityKind cap:InWellMixing ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ReviewedFileControl ;
    fac:isActive true ;
    fac:parameter ex:opentrons_ot2_maximum_mix_volume .

ex:opentrons_ot2_maximum_mix_volume
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "maximum_mix_volume" ;
    fac:propertyKind cap:MaximumMixVolume ;
    fac:realValue "300"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/MicroL> .

ex:opentrons_ot2_liquid_level_aware_aspiration
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "liquid_level_aware_aspiration" ;
    fac:capabilityKind cap:LiquidLevelAwareAspiration ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ReviewedFileControl ;
    fac:isActive true .

ex:opentrons_ot2_programmed_block_temperature_control
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "programmed_block_temperature_control" ;
    fac:capabilityKind cap:ProgrammedBlockTemperatureControl ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ReviewedFileControl ;
    fac:isActive true ;
    fac:parameter ex:opentrons_ot2_minimum_block_temperature,
        ex:opentrons_ot2_maximum_block_temperature,
        ex:opentrons_ot2_maximum_sample_count,
        ex:opentrons_ot2_minimum_thermal_sample_volume,
        ex:opentrons_ot2_maximum_thermal_sample_volume .

ex:opentrons_ot2_minimum_block_temperature
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "minimum_block_temperature" ;
    fac:propertyKind cap:MinimumBlockTemperature ;
    fac:realValue "4"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/DEG_C> .

ex:opentrons_ot2_maximum_block_temperature
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "maximum_block_temperature" ;
    fac:propertyKind cap:MaximumBlockTemperature ;
    fac:realValue "99"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/DEG_C> .

ex:opentrons_ot2_maximum_sample_count
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "maximum_sample_count" ;
    fac:propertyKind cap:MaximumSampleCount ;
    fac:integerValue 96 .

ex:opentrons_ot2_minimum_thermal_sample_volume
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "minimum_thermal_sample_volume" ;
    fac:propertyKind cap:MinimumThermalSampleVolume ;
    fac:realValue "10"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/MicroL> .

ex:opentrons_ot2_maximum_thermal_sample_volume
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "maximum_thermal_sample_volume" ;
    fac:propertyKind cap:MaximumThermalSampleVolume ;
    fac:realValue "100"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/MicroL> .

ex:opentrons_ot2_heated_lid_temperature_control
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "heated_lid_temperature_control" ;
    fac:capabilityKind cap:HeatedLidTemperatureControl ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ReviewedFileControl ;
    fac:isActive true ;
    fac:parameter ex:opentrons_ot2_minimum_lid_temperature,
        ex:opentrons_ot2_maximum_lid_temperature .

ex:opentrons_ot2_minimum_lid_temperature
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "minimum_lid_temperature" ;
    fac:propertyKind cap:MinimumLidTemperature ;
    fac:realValue "37"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/DEG_C> .

ex:opentrons_ot2_maximum_lid_temperature
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "maximum_lid_temperature" ;
    fac:propertyKind cap:MaximumLidTemperature ;
    fac:realValue "110"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/DEG_C> .

ex:manual_workstation
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "manual_workstation" ;
    sbol:hasNamespace <https://example.org/golden-gate> ;
    sbol:name "Golden Gate manual workstation" ;
    fac:facility ex:facility ;
    fac:assetKind fac:Workstation ;
    fac:locatedIn ex:automation_bench ;
    fac:isActive true ;
    fac:capability ex:manual_artifact_realization,
        ex:manual_material_provisioning,
        ex:manual_chemical_transformation,
        ex:manual_incubation,
        ex:manual_antibiotic_selection,
        ex:manual_plate_imaging,
        ex:manual_waste_handling .

ex:manual_artifact_realization
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "artifact_realization" ;
    fac:capabilityKind cap:ArtifactRealization ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true .

ex:manual_material_provisioning
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "material_provisioning" ;
    fac:capabilityKind cap:MaterialProvisioning ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true .

ex:manual_chemical_transformation
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "chemical_transformation" ;
    fac:capabilityKind cap:ChemicalTransformation ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true .

ex:manual_incubation
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "incubation" ;
    fac:capabilityKind cap:Incubation ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true ;
    fac:parameter ex:manual_incubation_duration .

ex:manual_incubation_duration
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "duration" ;
    fac:propertyKind cap:Duration ;
    fac:realValue "1"^^xsd:double ;
    fac:unit <http://qudt.org/vocab/unit/HR> .

ex:manual_antibiotic_selection
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "antibiotic_selection" ;
    fac:capabilityKind cap:AntibioticSelection ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true .

ex:manual_plate_imaging
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "plate_imaging" ;
    fac:capabilityKind cap:PlateImaging ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true .

ex:manual_waste_handling
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "waste_handling" ;
    fac:capabilityKind cap:WasteHandling ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true .

