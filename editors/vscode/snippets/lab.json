{
  "Module documentation": {
    "prefix": "doc module",
    "body": [
      "/*!",
      " * ${1:What this file is.}",
      " */"
    ],
    "description": "Document the module this file is"
  },
  "Documentation": {
    "prefix": "doc",
    "body": [
      "/**",
      " * ${1:One-line summary.}",
      " *",
      " * ${0:What a reader needs that the signature does not say.}",
      " */"
    ],
    "description": "Document the declaration below"
  },
  "Workflow": {
    "prefix": "workflow",
    "body": [
      "workflow ${1:name}(${2:design}: ${3:Plasmid}) -> ${4:Accepted<Plasmid> | Rejected<Plasmid>}:",
      "",
      "  ${0}"
    ],
    "description": "Create a durable Lab workflow"
  },
  "Workflow with named results": {
    "prefix": "workflow results",
    "body": [
      "workflow ${1:name}(",
      "  ${2:source}: ${3:Material<Plasmid>},",
      ") -> (",
      "  ${4:product}: ${5:Material<Plasmid>},",
      "  ${6:plate}: ${7:Material<Plate>},",
      "):",
      "  ${0}",
      "  return ${4:product}, ${6:plate}"
    ],
    "description": "Create a durable Lab workflow with named typed results"
  },
  "Reactive handler": {
    "prefix": "when",
    "body": [
      "when every ${1:30 min}:",
      "  ${0}"
    ],
    "description": "Create a reactive workflow handler"
  },
  "Outcome return": {
    "prefix": "return outcome",
    "body": [
      "return ${1:Accepted}{",
      "  material: ${2:material},",
      "  evidence: ${3:evidence},",
      "}"
    ],
    "description": "Return a structured workflow outcome"
  }
}
