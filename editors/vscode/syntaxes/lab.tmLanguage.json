{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lab",
  "scopeName": "source.lab",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#effects" },
    { "comment": "Before #types, so a < inside a string cannot open a type-argument span.", "include": "#strings" },
    { "comment": "Before #keywords, so `case Ready` scopes the variant as well as the keyword.", "include": "#types" },
    { "include": "#keywords" },
    { "include": "#quantities" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#fields" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "Documentation attaches to what it describes: /** */ to the declaration below it, /*! */ to the module. Both scope as documentation rather than as an ordinary comment.",
          "name": "comment.block.documentation.lab",
          "begin": "/\\*[*!]",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.lab",
          "match": "//.*$"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "^\\s*(use)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.lab" },
            "2": { "name": "entity.name.namespace.lab" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(part|circuit|plasmid|record|material|observation|evidence|event|outcome|workflow)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.lab" },
            "2": { "name": "entity.name.type.lab" }
          }
        },
        {
          "match": "^\\s*(state)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.lab" },
            "2": { "name": "variable.other.readwrite.lab" }
          }
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "match": "(<-)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.effect.lab" },
            "2": { "name": "support.function.action.lab" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lab",
          "match": "\\b(if|else|for|in|match|case|return)\\b"
        },
        {
          "name": "keyword.control.event.lab",
          "match": "\\b(when|every|after|emit)\\b"
        },
        {
          "name": "keyword.other.contract.lab",
          "match": "\\b(input|output|require|accept)\\b"
        },
        {
          "name": "keyword.operator.logical.lab",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.lab",
          "match": "\\b(None|true|false)\\b"
        }
      ]
    },
    "types": {
      "comment": "Types are recognised by position, not by an initial capital. Part names are arbitrary biological identifiers, so pTet, B0034, sfGFP and BsaI are values that happen to disagree about case, and colouring them by first letter splits one list of parts into two colours over a distinction the language does not make.",
      "patterns": [
        {
          "comment": "The head of a generic application, as in Material<Plasmid>.",
          "name": "support.type.lab",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=<[A-Za-z_])"
        },
        {
          "comment": "The type of a named value binding, as in reporter_sequence: DNA = dna(...).",
          "match": "(?<=:)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=)",
          "captures": {
            "1": { "name": "support.type.lab" }
          }
        },
        {
          "comment": "Type arguments, brackets included. Ends at the line as well as at the closing bracket, so an unmatched < cannot run away down the file.",
          "name": "support.type.lab",
          "begin": "(?<=[A-Za-z0-9_])<(?=[A-Za-z_])",
          "end": ">|$"
        },
        {
          "comment": "A workflow result type.",
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.lab" },
            "2": { "name": "support.type.lab" }
          }
        },
        {
          "comment": "The variant a match arm names.",
          "match": "\\b(case)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.lab" },
            "2": { "name": "support.type.lab" }
          }
        },
        {
          "comment": "The head of a constructor literal, as in Accepted{material: purified}.",
          "name": "support.type.lab",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\{)"
        }
      ]
    },
    "quantities": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])(-?\\d+(?:\\.\\d+)?)\\s*(ng/uL|ug/uL|mg/mL|nM|uM|mM|uL|mL|min|h|C)\\b",
          "captures": {
            "1": { "name": "constant.numeric.lab" },
            "2": { "name": "support.constant.unit.lab" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lab",
          "match": "(?<![A-Za-z0-9_])-?\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lab",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lab",
              "match": "\\\\[\\\\\"nrt]"
            }
          ]
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.lab",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "name": "variable.other.member.lab",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lab",
          "match": "<-|->|==|!=|<=|>=|\\.\\.|[=<>+\\-*/|]"
        }
      ]
    }
  }
}
