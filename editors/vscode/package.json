{
  "name": "lab-language",
  "displayName": "Lab Language",
  "description": "Language support for programmable biology with Lab.",
  "version": "0.1.0",
  "publisher": "lab-language",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:lab",
    "onCommand:lab.restartLanguageServer"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lab",
    "biology",
    "bioautomation",
    "synthetic biology",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lab-lang/lab"
  },
  "contributes": {
    "languages": [
      {
        "id": "lab",
        "aliases": [
          "Lab",
          "lab"
        ],
        "extensions": [
          ".lab"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lab",
        "scopeName": "source.lab",
        "path": "./syntaxes/lab.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lab",
        "path": "./snippets/lab.json"
      }
    ],
    "commands": [
      {
        "command": "lab.restartLanguageServer",
        "title": "Lab: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Lab",
      "properties": {
        "lab.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Optional path to the Lab language server executable. The extension uses its bundled server when this is empty, then falls back to lab-language-server on PATH."
        },
        "lab.languageServer.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication with the Lab language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "check": "tsc -p ./ --noEmit",
    "compile": "npm run check && esbuild src/extension.ts --bundle --external:vscode --format=cjs --platform=node --sourcemap --outfile=out/extension.js",
    "install:cursor": "node ./scripts/package.mjs --install-cursor",
    "package": "node ./scripts/package.mjs",
    "watch": "esbuild src/extension.ts --bundle --external:vscode --format=cjs --platform=node --sourcemap --outfile=out/extension.js --watch"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  }
}
