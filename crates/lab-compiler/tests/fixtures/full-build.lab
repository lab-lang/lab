use std.bio.designs
use std.bio.golden_gate

use std.bio.build
use std.lab.plasmid

buy part J23101
buy part J23106
buy part B0034
buy part GFP
buy part TetR
buy part B0015
buy backbone part_receiver
buy backbone region_receiver
buy backbone final_receiver
buy restriction_enzyme BsaI
buy restriction_enzyme BsmBI
buy chassis DH5alpha
buy antibiotic kanamycin

// A three-wave build expressed through typed workflow material dependencies.
//
// The compiler derives ordering from Material<Plasmid> workflow dataflow below.
// None of these declarations is assigned a biological assembly level.

plasmid promoter_carrier:
  sequence = dna("ACGT")
  backbone = part_receiver
  components = [J23101]
  restriction_enzyme = BsmBI
  assembly_replicates = 1
  require topology == circular
  accept sequence == design.sequence

plasmid regulator_region:
  sequence = dna("TGCATGCA")
  backbone = region_receiver
  components = [J23106, B0034, TetR, B0015]
  restriction_enzyme = BsaI
  assembly_replicates = 1
  require topology == circular
  accept sequence == design.sequence

plasmid reporter_region:
  sequence = dna("ACGTACGT")
  backbone = region_receiver
  components = [promoter_carrier, B0034, GFP, B0015]
  restriction_enzyme = BsaI
  assembly_replicates = 1
  require topology == circular
  accept sequence == design.sequence

plasmid final_device:
  sequence = dna("ACGTACGTACGT")
  backbone = final_receiver
  components = [reporter_region, regulator_region]
  restriction_enzyme = BsmBI
  assembly_replicates = 1
  require topology == circular
  accept sequence == design.sequence

strain reporter_host:
  chassis = DH5alpha
  plasmids = [final_device]
  selection = kanamycin
  transformation_replicates = 1
  plating_replicates = 1
  serial_dilutions = 1

workflow assemble_promoter_carrier() -> Material<Plasmid>:
  product <- realize promoter_carrier
  return product

workflow assemble_regulator_region() -> Material<Plasmid>:
  product <- realize regulator_region
  return product

workflow assemble_reporter_region(
  promoter_carrier: Material<Plasmid>,
) -> Material<Plasmid>:
  dependencies = [promoter_carrier]
  product <- realize reporter_region from dependencies
  return product

workflow assemble_final_device(
  reporter_region: Material<Plasmid>,
  regulator_region: Material<Plasmid>,
) -> Material<Plasmid>:
  dependencies = [reporter_region, regulator_region]
  product <- realize final_device from dependencies
  return product

workflow build_reporter_host(
  final_device: Material<Plasmid>,
) -> (
  strain: Material<Strain>,
  plate: Material<Plate>,
):
  dependencies = [final_device]
  cells <- provision DH5alpha
  strain, culture <- transform reporter_host from dependencies into cells
  culture <- recover culture for 1 h
  culture <- dilute culture
  plate <- plate culture on kanamycin
  return strain, plate
